# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT="3000"

# ADMIN_DEFAULT_USERNAME: (Optional) Initial admin account identifier
ADMIN_DEFAULT_USERNAME="clinic_admin"

# ADMIN_DEFAULT_EMAIL: (Optional) Initial admin notification email
ADMIN_DEFAULT_EMAIL="admin@clinic.com"

# ADMIN_INITIAL_PASSWORD: (Optional) Initial bootstrap password placeholder
# Leave blank to auto-generate a secure random temporary credential in .admin_bootstrap_credentials.txt
ADMIN_INITIAL_PASSWORD=""
